/* Sidebar Container */
#sidebar {
    background-color: #f5f5f5;
    padding: 8px;
    border: none;
}

/* Sidebar Button Container */
QFrame[sidebarItem="true"] {
    background-color: #8ba3d1;
    border-radius: 10px;
    min-height: 48px;
    max-height: 48px;
    min-width: 260px;
    max-width: 280px;
    margin-bottom: 4px;
}

/* Hover effect */
QFrame[sidebarItem="true"]:hover {
    background-color: #9db3dc;
}

/* Selected state */
QFrame[sidebarItem="true"][selected="true"] {
    background-color: #ffffff;
}

/* Label inside Item */
QFrame[sidebarItem="true"] QLabel {
    color: black;
    font-family: "Roboto", "Arial", sans-serif;
    font-size: 16px;
    font-weight: 500;
    padding-left: 8px;
}

/* Icon styling */
QLabel[class="sidebarIcon"] {
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
}

/* Dropdown arrow for documents */
#documentContainer::after {
    content: "▼";
    color: white;
    padding-right: 12px;
}

/* Layout margins */
QHBoxLayout {
    margin: 0px;
    padding: 8px 16px;
}

/* Responsive design for smaller screens */
@media (max-width: 600px) {
    QFrame[sidebarItem="true"] {
        min-width: 180px;
    }
} 