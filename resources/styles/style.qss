/* Global Reset */
* {
	border: none;
	background-color: transparent;
	background: none;
	padding: 0;
	margin: 0;
	color: #000000;
}

/* Font settings */
@font-face {
	font-family: 'Poppins';
	src: url('resources/fonts/Poppins-Regular.ttf');
}

@font-face {
	font-family: 'Poppins';
	src: url('resources/fonts/Poppins-Bold.ttf');
	font-weight: bold;
}

/* Main Window */
QMainWindow {
	background-color: #FFFFFF;
}

/* Stacked widget */
QStackedWidget {
	background-color: #FFFFFF;
	border: none;
}

/* Sidebar */
#sidebar {
	background-color: #f5f5f5;
	min-width: 280px;
	max-width: 280px;
	padding: 8px;
}

/* Sidebar Containers - ONLY DEFINITION */
#homeContainer,
#documentContainer,
#angebotContainer,
#rechnungenContainer,
#lieferscheineContainer,
#kundenContainer,
#mitarbeiterContainer,
#produkteContainer,
#lagerContainer,
#kasseContainer,
#bestellungenContainer {
	background-color: #8ba1c2;
	border-radius: 12px;
	min-height: 54px;
	max-height: 54px;
	padding: 0 16px;
	margin-bottom: 8px;
	display: flex;
	align-items: center;
}

/* Hover effect */
#homeContainer:hover,
#documentContainer:hover,
#angebotContainer:hover,
#rechnungenContainer:hover,
#lieferscheineContainer:hover,
#kundenContainer:hover,
#mitarbeiterContainer:hover,
#produkteContainer:hover,
#lagerContainer:hover,
#kasseContainer:hover,
#bestellungenContainer:hover {
	background-color: white;
}

/* Icons */
#homeIcon,
#documentIcon,
#angebotIcon,
#rechnungenIcon,
#lieferscheineIcon,
#kundenIcon,
#mitarbeiterIcon,
#produkteIcon,
#lagerIcon,
#kasseIcon,
#bestellungenIcon {
	min-width: 24px;
	max-width: 24px;
	min-height: 24px;
	max-height: 24px;
	padding: 0;
	margin: 0;
}

/* Text Labels */
#homeText,
#documentText,
#angebotText,
#rechnungenText,
#lieferscheineText,
#kundenText,
#mitarbeiterText,
#produkteText,
#lagerText,
#kasseText,
#bestellungenText {
	padding-left: 12px;
	color: black;
	font-family: "Roboto";
	font-size: 16px;
	font-weight: bold;
}

/* Dropdown arrow for Dokumente */
#documentsArrow {
	margin-left: auto;
	color: black;
	font-weight: bold;
}

/* REMOVE ALL OTHER SIDEBAR RELATED STYLES */

/* Active Container */
#productsContainer {
	background-color: #FFFFFF;
}

/* Labels */
QLabel {
	background-color: transparent;
	color: rgb(0, 0, 0);
	padding: 5px;
	margin: 5px;
	height: 10px;
	line-height: 10px;
}

/* Sidebar containers */
#homeContainer,
#documentContainer,
#productsContainer,
#customersContainer,
#workersContainer,
#casherContainer,
#ordersContainer {
	background-color: #98aecb;
	border-radius: 12px;
	padding: 0 16px;
	margin-bottom: 8px;
}

#homeContainer:hover,
#documentContainer:hover,
#productsContainer:hover,
#customersContainer:hover,
#workersContainer:hover,
#casherContainer:hover,
#ordersContainer:hover {
	background-color: white;
}

/* Sidebar labels */
#homeLabel,
#documentLabel,
#productsLabel,
#customersLabel,
#workersLabel,
#casherLabel,
#ordersLabel {
	color: black;
	font-family: 'Poppins';
	font-size: 16px;
	font-weight: bold;
	padding-left: 12px;
}

/* Sidebar icons */
#homeIcon,
#documentIcon,
#productsIcon,
#customersIcon,
#workersIcon,
#casherIcon,
#ordersIcon {
	width: 24px;
	height: 24px;
	padding: 0;
	margin: 0;
}

/* Side container */
#sideContainer {
	background-color: #98aecb;
	padding: 10px;
	border-radius: 5px;
	border: none;
}

#sideContainer:hover {
	background-color: #e8e8e8;
}

#sideIconButton {
	background-color: transparent;
	border: none;
}

#sideLabel {
	color: rgb(0, 0, 0);
	font-weight: bold;
}

/* Custom title bar */
#CustomTitleBar {
	background-color: #e6e6e6;
	border: none;
}

#CustomTitleBar QPushButton {
	background-color: #6887b6;
	color: white;
	border: none;
}

#CustomTitleBar QPushButton:hover {
	background-color: #555;
}

/* Settings window */
#settingsWindow {
	background-color: #98aecb;
	border: none;
}

#settingsStackedWidget {
	background-color: #98aecb;
	border: none;
}

#settingsButton {
	border-radius: 15px;
	background-color: #e6e6e6;
	color: #ffffff;
	border: none;
}

#settingsButton:hover {
	background-color: rgb(177, 173, 173);
}

/* Product card */
#productCard {
	padding: 0px;
	border-radius: 15px;
	background-color: white;
	border: none;
}

#productCard QLabel {
	color: black;
}

/* Input widgets in stacked widget */
#inputsStackedWidget QLineEdit,
#inputsStackedWidget QDateEdit,
#inputsStackedWidget QComboBox,
#inputsStackedWidget QRadioButton {
	background-color: #6887b6;
	color: rgb(0, 0, 0);
	border: none;
}

#inputsStackedWidget QPushButton {
	background-color: #6887b6;
	border: none;
}

/* Message box */
QMessageBox QLabel {
	color: white;
}

/* General styles */
QDialog {
	background-color: white;
	border: none;
}

QColorDialog {
	background-color: white;
	border: none;
}

QTextEdit {
	background-color: white;
	color: #a9b7c6;
	border: none;
}

QPlainTextEdit {
	selection-background-color: #007b50;
	background-color: white;
	border: none;
	color: #a9b7c6;
}

QPushButton {
	border: none;
	color: #a9b7c6;
	padding: 2px;
	background-color: transparent;
}

QPushButton::default {
	border: none;
	color: #a9b7c6;
	padding: 2px;
	background-color: white;
}

QToolButton {
	border: none;
	color: #a9b7c6;
	padding: 2px;
	background-color: white;
}

QToolButton:hover {
	border: none;
	color: #FFFFFF;
	padding-bottom: 1px;
	background-color: white;
}

QPushButton:hover {
	border: none;
	color: #FFFFFF;
	padding-bottom: 2px;
	background-color: white;
}

QPushButton:pressed {
	border: none;
	color: #37efba;
	padding-bottom: 1px;
	background-color: white;
}

QPushButton:disabled {
	border: none;
	color: #808086;
	padding-bottom: 1px;
	background-color: white;
}

QLineEdit {
	border: none;
	border-radius: 4px;
	padding: 0 8px;
	color: #a9b7c6;
	background: white;
	selection-background-color: #007b50;
	selection-color: #FFFFFF;
}

QLCDNumber {
	color: #37e6b4;
}

QProgressBar {
	text-align: center;
	color: rgb(240, 240, 240);
	border: none;
	border-radius: 10px;
	background-color: white;
}

QProgressBar::chunk {
	background-color: #04b97f;
	border-radius: 5px;
}

QMenuBar {
	background-color: white;
}

QMenuBar::item {
	color: #a9b7c6;
	spacing: 3px;
	padding: 1px 4px;
	background: white;
}

QMenuBar::item:selected {
	background: white;
	color: #FFFFFF;
}

QMenu::item:selected {
	border: none;
	color: #FFFFFF;
	padding-left: 15px;
	padding-top: 4px;
	padding-bottom: 4px;
	padding-right: 7px;
	background-color: white;
}

QMenu::item {
	border: none;
	color: #a9b7c6;
	padding-left: 17px;
	padding-top: 4px;
	padding-bottom: 4px;
	padding-right: 7px;
	background-color: white;
}

QMenu {
	background-color: white;
}

QTabWidget {
	color: rgb(0, 0, 0);
	background-color: white;
}

QTabWidget::pane {
	border: none;
	background-color: white;
	border-radius: 6px;
}

QTabBar::tab {
	border: none;
	color: #808086;
	padding: 3px;
	margin-left: 3px;
	background-color: white;
}

QTabBar::tab:selected, QTabBar::tab:last:selected, QTabBar::tab:hover {
	border: none;
	color: #FFFFFF;
	padding-left: 3px;
	padding-bottom: 2px;
	margin-left: 3px;
	background-color: white;
}

QCheckBox {
	color: #a9b7c6;
	padding: 2px;
}

QCheckBox:disabled {
	color: #808086;
	padding: 2px;
}

QCheckBox:hover {
	border-radius: 4px;
	border: none;
	padding-left: 1px;
	padding-right: 1px;
	padding-bottom: 1px;
	padding-top: 1px;
	background-color: white;
}

QCheckBox::indicator:checked {
	height: 10px;
	width: 10px;
	border: none;
	color: #a9b7c6;
	background-color: #04b97f;
}

QCheckBox::indicator:unchecked {
	height: 10px;
	width: 10px;
	border: none;
	color: #a9b7c6;
	background-color: transparent;
}

QRadioButton {
	color: #a9b7c6;
	background-color: white;
	padding: 1px;
}

QRadioButton::indicator:checked {
	height: 10px;
	width: 10px;
	border: none;
	border-radius: 5px;
	color: #a9b7c6;
	background-color: #04b97f;
}

QRadioButton::indicator:!checked {
	height: 10px;
	width: 10px;
	border: none;
	border-radius: 5px;
	color: #a9b7c6;
	background-color: transparent;
}

QStatusBar {
	color: #027f7f;
}

QSpinBox {
	color: #a9b7c6;
	background-color: white;
}

QDoubleSpinBox {
	color: #a9b7c6;
	background-color: white;
}

QTimeEdit {
	color: #a9b7c6;
	background-color: white;
}

QDateTimeEdit {
	color: #a9b7c6;
	background-color: white;
}

QDateEdit {
	color: #a9b7c6;
	background-color: white;
}

QComboBox {
	color: #a9b7c6;
	background: white;
}

QComboBox:editable {
	background: white;
	color: #a9b7c6;
	selection-background-color: white;
}

QComboBox QAbstractItemView {
	color: #a9b7c6;
	background: white;
	selection-color: #FFFFFF;
	selection-background-color: white;
}

QComboBox:!editable:on, QComboBox::drop-down:editable:on {
	color: #a9b7c6;
	background: white;
}

QFontComboBox {
	color: #a9b7c6;
	background-color: white;
}

QToolBox {
	color: #a9b7c6;
	background-color: white;
}

QToolBox::tab {
	color: #a9b7c6;
	background-color: white;
}

QToolBox::tab:selected {
	color: #FFFFFF;
	background-color: white;
}

QScrollArea {
	color: #FFFFFF;
	background-color: white;
}

QSlider::groove:horizontal {
	height: 5px;
	background: #04b97f;
}

QSlider::groove:vertical {
	width: 5px;
	background: #04b97f;
}

QSlider::handle:horizontal {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #b4b4b4, stop:1 #8f8f8f);
	border: none;
	width: 14px;
	margin: -5px 0;
	border-radius: 7px;
}

QSlider::handle:vertical {
	background: qlineargradient(x1:1, y1:1, x2:0, y2:0, stop:0 #b4b4b4, stop:1 #8f8f8f);
	border: none;
	height: 14px;
	margin: 0 -5px;
	border-radius: 7px;
}

QSlider::add-page:horizontal {
	background: white;
}

QSlider::add-page:vertical {
	background: white;
}

QSlider::sub-page:horizontal {
	background: #04b97f;
}

QSlider::sub-page:vertical {
	background: #04b97f;
}

#artikelContainer {
	background-color: white;
	margin-top: 70px;
	margin-bottom: 50px;
}

/* Table styles */
QTableWidget {
	background-color: #e6e6e6;
	color: #000000;
	gridline-color: #444444;
	border: none;
}

QTableWidget::item {
	padding: 5px;
	color: #000000;
	background-color: #e6e6e6;
}

QTableWidget QHeaderView::section {
	background-color: #e6e6e6;
	color: #000000;
	border: none;
	padding: 8px;
	font-weight: bold;
}

QTableWidget::item:selected {
	background-color: #d1d1d1;
	color: #000000;
}

QTableCornerButton::section {
	background-color: #e6e6e6;
}

QHeaderView {
	background-color: #e6e6e6;
}

QHeaderView::section {
	background-color: #e6e6e6;
	color: #000000;
	padding: 8px;
	border: none;
}

/* Scrollbars for tables */
QTableWidget QScrollBar:vertical {
	background-color: #e6e6e6;
	width: 12px;
}

QTableWidget QScrollBar:horizontal {
	background-color: #e6e6e6;
	height: 12px;
}

#CustomTitleBar #settings_button {
	background-color: transparent;
}

#CustomTitleBar #settings_button:hover {
	background-color: #ffffff;
}

/* setting window */
#settingsWindow {
	background-color: #98aecb;
}

#settingsStackedWidget {
	background-color: #98aecb;
}

#settingsButton {
	border-radius: 15px;
	background-color: #e6e6e6;
	color: #ffffff;
}

#settingsButton:hover {
	background-col000000b(177, 173, 173);
}

#buttonLabel {
	color: black;
	font-size: 14px;
}

#icon_object {
	background-color: transparent;
}

#drop_container {
	background-color: rgba(255, 255, 255, 8);
}

#headerLabel {
	font-size: 18px;
}

#productCard QLabel {
	color: black;
}

#productCard {
	padding: 0px;
	border-radius: 15px;
	background-color: white;
}

#inputsStackedWidget QLineEdit,
#inputsStackedWidget QDateEdit,
#inputsStackedWidget QComboBox,
#inputsStackedWidget QRadioButton {
	background-color: #6887b6;
	color: rgb(0, 0, 0);
}

#inputsStackedWidget QPushButton {
	background-color: #6887b6;
}

QMessageBox QLabel {
	color: white;
}